{
  "name": "sewagurubackend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon src/server.ts",
    "build": "tsc && node -e \"const fs=require('node:fs');const path=require('node:path');const source=path.join(process.cwd(),'src','generated');const target=path.join(process.cwd(),'dist','generated');if(!fs.existsSync(source)){throw new Error('Prisma generated client not found at '+source+'. Run \\\"npx prisma generate\\\" before building.');}fs.rmSync(target,{recursive:true,force:true});fs.mkdirSync(path.dirname(target),{recursive:true});fs.cpSync(source,target,{recursive:true});console.log('Copied generated Prisma client to '+target);\"",
    "start": "node dist/server.js",
    "seed:services": "ts-node --project scripts/tsconfig.json scripts/seed-services.ts",
    "backfill:branch-services": "ts-node --project scripts/tsconfig.json scripts/backfill-branch-services.ts",
    "seed:banners": "ts-node --project scripts/tsconfig.json scripts/seed-banners.ts",
    "seed:homepage-extras": "ts-node --project scripts/tsconfig.json scripts/seed-homepage-extras.ts",
    "seed:test-account": "ts-node --project scripts/tsconfig.json scripts/seed-test-account.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
