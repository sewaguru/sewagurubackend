{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "Node16",
    "target": "ES6",
    "moduleResolution": "node16",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": true,

    "types": [
      "node",
      "express",
      "multer"
    ],

    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },

  "include": ["src"]
}
