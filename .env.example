# Optional: absolute or root-relative path to an alternate dotenv file.
# When set it is loaded before .env.production / .env (highest priority).
DOTENV_CONFIG_PATH=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sewaguru
DATABASE_POOL_MAX=3
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

NODE_ENV=development
PORT=5000
TRUST_PROXY=false
JWT_SECRET=change-me
ENABLE_TRASH_CLEANUP_JOB=false
ENABLE_NOTIFICATION_CAMPAIGN_SCHEDULER=true
NOTIFICATION_CAMPAIGN_SCHEDULER_INTERVAL_MS=15000
ENABLE_ACCOUNT_DELETION_JOB=false
ACCOUNT_DELETION_JOB_INTERVAL_MS=3600000
ACCOUNT_DELETION_JOB_BATCH_SIZE=25

CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax

# Google OAuth. The GOOGLE_OAUTH_* names below are accepted as aliases for the
# canonical names (AUTH_GOOGLE_ENABLED / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# / GOOGLE_CALLBACK_URL) — set one style, not both.
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# GOOGLE_OAUTH_ENABLED=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=

# Sign in with Apple (native iOS flow). No private key or Service ID
# needed — the identity token is verified against Apple's public JWKS.
AUTH_APPLE_ENABLED=false
APPLE_BUNDLE_ID=in.sewaguru.app

AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PAYMENT_ENABLED=false
ALLOW_PAY_LATER=true

PHONEPE_ENABLED=false
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_REDIRECT_BASE_URL=http://localhost:3000

EMAIL_ENABLED=false
EMAIL_PROVIDER=LOG
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

RAPID_SMS_ENABLED=false
RAPID_SMS_BASE_URL=https://1.rapidsms.co.in/api/push
RAPID_SMS_API_KEY=
RAPID_SMS_SENDER_ID=
RAPID_SMS_ROUTE=Trans
RAPID_SMS_ALLOW_INSECURE_TLS=false
RAPID_SMS_PE_ID=
RAPID_SMS_TEMPLATE_ID=
RAPID_SMS_TIMEOUT_MS=10000
OTP_EXPIRY_MINUTES=10
RAPID_SMS_OTP_MESSAGE=

# Test account bypass — Play Store / App Store review only. Leave disabled
# unless you're submitting for review.
TEST_OTP_BYPASS_ENABLED=false
TEST_OTP_BYPASS_EMAIL=
TEST_OTP_BYPASS_PHONE=
TEST_OTP_BYPASS_CODE=111111
